# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit source code files normalized to LF
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Dotfiles
.gitignore text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

# Windows command and batch scripts must remain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - preserve exact byte layout
*.jar binary
*.war binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
