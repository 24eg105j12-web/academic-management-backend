# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.x with automatic H2 fallback)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/academic_ai_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Spring AI / OpenAI Configuration (Optional - Intelligent Heuristic Engine runs automatically if omitted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS Configuration
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
